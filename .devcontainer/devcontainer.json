{
  "name": "fawkes Development",
  "image": "ghcr.io/paruff/fawkes-space:2.0.0@sha256:def9302d47d242bc11c244271f19c404f37fe922c902cc1941be41004d59ecee",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "streetsidesoftware.code-spell-checker",
        "yzhao062.agent-style"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "github.copilot.enable": {
          "*": true
        }
      }
    }
  },
  "forwardPorts": [],
  "remoteUser": "dev",
  "postCreateCommand": "pre-commit install && pre-commit install-hooks && bash scripts/shift-left.sh doctor",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}

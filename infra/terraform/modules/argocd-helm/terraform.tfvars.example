# Example configuration for ArgoCD Helm module
# Note: Providers (kubernetes and helm) must be configured by the caller

release_name    = "argocd"
chart_repo      = "https://argoproj.github.io/argo-helm"
chart_name      = "argo-cd"
chart_version   = "10.20.0" # Exact version (ADR-040); matches the module default
namespace       = "argocd"

# Helm deployment options
timeout         = 600
atomic          = true
recreate_pods   = true
create_namespace = true
skip_crds       = false
